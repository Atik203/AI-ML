   "source": [
    "text = \"The rain in Spain.\"\n",
    "\n",
    "# Search for the word \"rain\" in the text\n",
    "match = re.search(r\"rain\", text)\n",
    "print(\"Found:\", match.group())\n",
    "\n",
    "# search the . character in the text\n",
    "match_dot = re.search(r\"\\.\", text)\n",
    "print(\"Found dot:\", match_dot.group())\n",
    "            "
   ]
